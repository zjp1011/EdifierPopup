<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp">

        <!-- 耳机 + 光环 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <View android:id="@+id/ring1" android:layout_width="90dp" android:layout_height="90dp"
                android:layout_gravity="center" android:alpha="0"
                android:background="@drawable/bg_ring" />
            <View android:id="@+id/ring2" android:layout_width="90dp" android:layout_height="90dp"
                android:layout_gravity="center" android:alpha="0"
                android:background="@drawable/bg_ring" />
            <View android:id="@+id/ring3" android:layout_width="90dp" android:layout_height="90dp"
                android:layout_gravity="center" android:alpha="0"
                android:background="@drawable/bg_ring" />

            <ImageView android:id="@+id/budLeft" android:layout_width="44dp" android:layout_height="78dp"
                android:layout_gravity="center" android:src="@drawable/ic_bud" />
            <ImageView android:id="@+id/budRight" android:layout_width="44dp" android:layout_height="78dp"
                android:layout_gravity="center" android:scaleX="-1" android:src="@drawable/ic_bud" />
        </FrameLayout>

        <TextView
            android:id="@+id/deviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EDIFIER"
            android:textColor="#F4F5F7"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="● 已连接"
            android:textColor="#3DDC97"
            android:textSize="14sp" />

        <!-- 电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#F4F5F7"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/batteryBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/bg_battery_bar" />
        </LinearLayout>

        <Button
            android:id="@+id/closeBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn"
            android:text="关闭"
            android:textColor="#F4F5F7" />

        <View
            android:id="@+id/timerBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="#3DDC97" />
    </LinearLayout>
</FrameLayout>
